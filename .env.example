# npm run setup creates a private .env.local with random secrets.
APP_URL=http://localhost:3107
DATABASE_URL=postgresql://recast:REPLACE_DB_PASSWORD@127.0.0.1:58432/recast
POSTGRES_PASSWORD=REPLACE_DB_PASSWORD
SESSION_SECRET=REPLACE_SESSION_SECRET
REGISTRATION_ENABLED=true
INVITE_CODE=

BYTEPLUS_API_KEY=
BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL=dreamina-seedance-2-5-260628

# Virtual Portrait OpenAPI credentials, separate from the ModelArk API key.
BYTEPLUS_ACCESS_KEY=
BYTEPLUS_SECRET_KEY=
BYTEPLUS_SESSION_TOKEN=
BYTEPLUS_REGION=ap-southeast-1
BYTEPLUS_PROJECT=default
BYTEPLUS_ASSET_GROUP=
# Optional verified Seedream 5.5 model/endpoint ID. No automatic fallback.
SEEDREAM_MODEL=

FAL_KEY=
FAL_SAM_ENDPOINT=fal-ai/sam-3-1/video

# Set tos for live processing. Local supports development/API checks.
STORAGE_MODE=local
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_SESSION_TOKEN=
TOS_BUCKET=
TOS_REGION=ap-southeast-1
# Public endpoint required for fal.ai and browser reads.
TOS_ENDPOINT=tos-ap-southeast-1.bytepluses.com
MEDIA_ROOT=.data
WORKER_POLL_MS=2000
MAX_DAILY_JOBS=20
MAX_ACTIVE_JOBS=2
