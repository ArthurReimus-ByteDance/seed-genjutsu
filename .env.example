# Use .env or .env.local; npm run setup preserves either and creates one only if missing.
# Values are server-only. Both .env and .env.local are ignored; never commit credentials.
# Local, single-user studio: no database or application-auth credentials needed.

# Local application settings. APP_URL must use localhost or a loopback IP.
APP_URL=http://localhost:3107
# Start the worker from this folder: worker for dev, worker:production for production.
MEDIA_ROOT=.data

# REQUIRED for live generation: BytePlus ModelArk API key.
# This bearer key is separate from the shared BytePlus IAM access/secret keys.
BYTEPLUS_API_KEY=
BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# Optional Enhance prompt via Vercel AI SDK; shares BYTEPLUS_API_KEY.
# Activate DeepSeek V4.1 Flash 1017 in ModelArk. No OpenAI/Vercel key needed.
# Overrides must support thinking: disabled and JSON Schema output.
PROMPT_ENHANCER_MODEL=deepseek-v4-1-flash-261017
# Confirm model access, or replace with your account's supported endpoint ID.
SEEDANCE_2_MODEL=dreamina-seedance-2-0-260128
SEEDANCE_2_5_MODEL=dreamina-seedance-2-5-260628

# REQUIRED for live generation: Meta Model API key with SAM 3.1 access.
# SAM uses https://api.meta.ai/v1/responses and model sam-3.1 directly.
META_API_KEY=

# REQUIRED: one BytePlus IAM pair with TOS bucket and Virtual Portrait permissions.
BYTEPLUS_ACCESS_KEY=
BYTEPLUS_SECRET_KEY=
# Optional: shared by TOS and Virtual Portrait when using temporary STS credentials.
BYTEPLUS_SESSION_TOKEN=
BYTEPLUS_REGION=ap-southeast-1
BYTEPLUS_PROJECT=default
# Optional: existing AIGC asset-group ID. Blank creates and saves a group locally.
BYTEPLUS_ASSET_GROUP=

# REQUIRED for live generation: private TOS bucket; uses the BYTEPLUS keys above.
# Change STORAGE_MODE to tos after configuring it. Local is for UI/API testing.
STORAGE_MODE=local
TOS_BUCKET=
# Match your bucket's region and its PUBLIC endpoint (hostname without https://).
TOS_REGION=ap-southeast-1
TOS_ENDPOINT=tos-ap-southeast-1.bytepluses.com

# OPTIONAL: Seedream 5.0 Pro for scene-image preparation.
# Uses BYTEPLUS_API_KEY. Leave blank to disable this optional step; no fallback.
SEEDREAM_MODEL=dola-seedream-5-0-pro-260628

# Optional local worker tuning and generation limits.
WORKER_POLL_MS=2000
MAX_DAILY_JOBS=20
MAX_ACTIVE_JOBS=2

# Optional: true enables /preview with mock APIs and sample videos; no keys needed.
DEMO_ENABLED=false
